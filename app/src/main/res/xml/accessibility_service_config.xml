<!--
    Scoped as narrowly as the platform allows: BCR only needs to know that an in-call screen is in
    front and, when the call screening role has not been granted, to read the other party's number
    off that screen. It does not request the ability to perform gestures, retrieve window content
    outside the active window, or observe typing.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="300"
    android:summary="@string/accessibility_service_summary" />
